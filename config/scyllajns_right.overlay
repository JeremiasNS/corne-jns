 *
 * ScyllaJNS — lado direito
 * Mesmos pinos físicos da esquerda, col-offset = 6 mapeia para C6–C11
 */

#include "corne.dtsi"

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
        = <&pro_micro 10 GPIO_ACTIVE_HIGH>   /* C6  — P0.09 */
        , <&pro_micro 16 GPIO_ACTIVE_HIGH>   /* C7  — P0.10 */
        , <&pro_micro 14 GPIO_ACTIVE_HIGH>   /* C8  — P1.11 */
        , <&pro_micro 15 GPIO_ACTIVE_HIGH>   /* C9  — P1.13 */
        , <&pro_micro 18 GPIO_ACTIVE_HIGH>   /* C10 — P1.15 */
        , <&pro_micro 19 GPIO_ACTIVE_HIGH>   /* C11 — P0.02 */
        ;

    row-gpios
        = <&pro_micro 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R0  — P1.00 */
        , <&pro_micro 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R1  — P0.11 */
        , <&pro_micro 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R2  — P1.04 */
        , <&pro_micro 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R3  — P1.06 */
        ;
    
};