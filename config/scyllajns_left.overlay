 *
 * ScyllaJNS — lado esquerdo
 * Colunas C0–C5, col2row: saídas sem pull
 */

#include "corne.dtsi"

&kscan0 {
    col-gpios
        = <&pro_micro 4 GPIO_ACTIVE_HIGH>   /* C0  — P0.22 */
        , <&pro_micro 5 GPIO_ACTIVE_HIGH>   /* C1  — P0.24 */
        , <&pro_micro 6 GPIO_ACTIVE_HIGH>   /* C2  — P1.00 */
        , <&pro_micro 7 GPIO_ACTIVE_HIGH>   /* C3  — P0.11 */
        , <&pro_micro 8 GPIO_ACTIVE_HIGH>   /* C4  — P1.04 */
        , <&pro_micro 9 GPIO_ACTIVE_HIGH>   /* C5  — P1.06 */
        ;

    row-gpios
        = <&pro_micro 15  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R0  — P1.13 */
        , <&pro_micro 14  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R1  — P1.11 */
        , <&pro_micro 16  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R2  — P0.10 */
        , <&pro_micro 10  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R3  — P0.09 */
        ;
};
